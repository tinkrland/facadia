    { "target": "utilities.*", "at0": 0.4, "at1": 3.0 },
    { "target": "details.ac_unit", "at0": 0.4, "at1": 3.0 },
    { "target": "details.utility_wires", "at0": 0.4, "at1": 3.0 }
  ] }
