{
  "name": "@facadia/core",
  "version": "0.1.0",
  "description": "in-place svg mutation under a fixed constraint graph \u2014 the procedural facade architecture engine for nocturne views",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js",
    "street": "esbuild scripts/street.ts --bundle --platform=node --format=esm --outfile=dist/street.mjs --log-level=error && node dist/street.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "esbuild": "^0.24.0"
  }
}
